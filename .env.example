# Copiar a .env (ignorado por git) y ajustar los valores locales.
# `make up` crea el .env automáticamente si no existe.

# --- cmd/api -----------------------------------------------------------------
SUPER_ADMIN_EMAIL=random@gmail.com
SUPER_ADMIN_PASSWORD=12345678910

# Dirección de escucha del servidor HTTP.
HTTP_ADDR=:8080

# Conexión a PostgreSQL (con PostGIS).
DATABASE_URL=postgres://movo:movo@localhost:5432/movo?sslmode=disable

# Nivel de log de slog: debug | info | warn | error.
LOG_LEVEL=info

# Tiempo máximo de apagado ordenado.
SHUTDOWN_TIMEOUT=10s

# Secreto HS256 que firma los access tokens (obligatorio, mínimo 32 bytes).
# Valor SOLO de desarrollo: en producción generar uno propio y mantenerlo fuera
# del repo (por ejemplo `openssl rand -base64 48`).
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Vigencia del access token y del refresh token (el refresh debe ser mayor).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Primer super admin (opcional; las dos variables van juntas). La API lo crea al
# arrancar si no existe y nunca modifica una cuenta existente, así que cambiar la
# contraseña acá no la cambia. Descomentar y usar valores propios:
# SUPER_ADMIN_EMAIL=admin@movo.local
# SUPER_ADMIN_PASSWORD=

# --- deploy/docker-compose.yml (solo desarrollo) -----------------------------

POSTGRES_USER=movo
POSTGRES_PASSWORD=movo
POSTGRES_DB=movo
POSTGRES_PORT=5432

# Object storage S3 local (RustFS). Credenciales SOLO de desarrollo: no se
# usan fuera de localhost ni se copian a producción (allá va un servicio
# gestionado: R2, B2 o S3).
RUSTFS_ACCESS_KEY=movo
RUSTFS_SECRET_KEY=movo12345
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Imagen pineada a propósito: RustFS es 1.0.x y es sólo para desarrollo.
RUSTFS_IMAGE=rustfs/rustfs:1.0.3

PLAN_STARTER_MAX_BRANCHES=2
PLAN_STARTER_MAX_ACTIVE_SERVICES=3
PLAN_STARTER_PRICE=19800
PLAN_PRO_MAX_BRANCHES=4
PLAN_PRO_MAX_ACTIVE_SERVICES=0
PLAN_PRO_PRICE=29800
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=movo
S3_ACCESS_KEY=movo
S3_SECRET_KEY=movo12345
S3_PATH_STYLE=true
S3_PRESIGN_TTL=10m
S3_ENSURE_BUCKET=true
S3_CORS_ORIGINS=http://localhost:3000

# Cuántas fotos puede tener cada negocio (1 a 30). Si no se define, son 10.
MAX_BUSINESS_IMAGES=10

# Geocodificación de direcciones (Nominatim público en el piloto). El User-Agent es
# obligatorio y debe identificar la app y un contacto (política de uso de Nominatim).
# La API aplica 1 request/s y cachea las respuestas.
GEOCODER_USER_AGENT="MOVO/1.0 (contacto@movo.example)"
GEOCODER_URL=https://nominatim.openstreetmap.org

# --- frontend ----------------------------------------------------------------
# Tiles de los mapas (Next los lee de frontend/.env.local). Piloto: tiles públicos de
# OSM; en producción, Protomaps o un proveedor, sin tocar código. Plantilla Leaflet.
# NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png