# Copiar a .env (ignorado por git) y ajustar los valores locales.
# `make up` crea el .env automáticamente si no existe.

# --- cmd/api -----------------------------------------------------------------

# Dirección de escucha del servidor HTTP.
HTTP_ADDR=:8080

# Conexión a PostgreSQL (con PostGIS).
DATABASE_URL=postgres://movo:movo@localhost:5432/movo?sslmode=disable

# Nivel de log de slog: debug | info | warn | error.
LOG_LEVEL=info

# Tiempo máximo de apagado ordenado.
SHUTDOWN_TIMEOUT=10s

# --- deploy/docker-compose.yml (solo desarrollo) -----------------------------

POSTGRES_USER=movo
POSTGRES_PASSWORD=movo
POSTGRES_DB=movo
POSTGRES_PORT=5432

# Object storage S3 local (RustFS). Credenciales SOLO de desarrollo: no se
# usan fuera de localhost ni se copian a producción (allá va un servicio
# gestionado: R2, B2 o S3).
RUSTFS_ACCESS_KEY=movo
RUSTFS_SECRET_KEY=movo12345
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Imagen pineada a propósito: RustFS es 1.0.x y es sólo para desarrollo.
RUSTFS_IMAGE=rustfs/rustfs:1.0.3
