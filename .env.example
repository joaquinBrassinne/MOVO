# Copiar a .env (ignorado por git) y ajustar los valores locales.
# La Fase 0 solo necesita estas variables; el resto se agrega en su fase.

# Dirección de escucha del servidor HTTP (cmd/api).
HTTP_ADDR=:8080

# Conexión a PostgreSQL (con PostGIS).
DATABASE_URL=postgres://movo:movo@localhost:5432/movo?sslmode=disable

# Nivel de log de slog: debug | info | warn | error.
LOG_LEVEL=info

# Tiempo máximo de apagado ordenado.
SHUTDOWN_TIMEOUT=10s
