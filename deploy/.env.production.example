# Plantilla de PRODUCCIÓN (SDD 8.4). Solo placeholders: copiala a un archivo fuera del repo
# (o al gestor de secretos del VPS) y completá. NUNCA commitees valores reales.
# Todo lo marcado CAMBIAR no puede quedar con un valor de desarrollo.

# =============================================================================
# cmd/api y cmd/worker
# =============================================================================

# --- Super admin (CAMBIAR) ---------------------------------------------------
# Email real tuyo y una contraseña nueva, larga, de gestor de contraseñas.
SUPER_ADMIN_EMAIL=CAMBIAR@tu-dominio.com
SUPER_ADMIN_PASSWORD=CAMBIAR

# --- HTTP --------------------------------------------------------------------
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
# Swagger UI en /docs. En producción apagado.
API_DOCS=false

# --- Base de datos (CAMBIAR) -------------------------------------------------
# Usuario propio (no movo/movo) y TLS. Si Postgres corre en la misma red docker
# privada podés usar sslmode=disable; si es gestionado, sslmode=require.
# Con el postgres del compose prod: host "postgres", usuario/clave/base = POSTGRES_* de abajo.
DATABASE_URL=postgres://USUARIO:CLAVE@postgres:5432/movo?sslmode=disable
POSTGRES_USER=USUARIO
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=movo
# VPS de 1 GB: 10 o menos (SDD 8.4). Ajustar al límite de conexiones de la base.
DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m

# --- Auth (CAMBIAR) ----------------------------------------------------------
# openssl rand -base64 48   (mínimo 32 bytes). Rotarlo cierra todas las sesiones.
JWT_SECRET=CAMBIAR
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Proxy / IP real del cliente (OBLIGATORIO detrás de Caddy) ---------------
# IPs o CIDR de TODOS los saltos entre el cliente y la API: Caddy y el servidor de Next.
# Con la red docker del compose suele ser su subred (docker network inspect). Sin esto,
# los límites de login, cupones y búsqueda cuentan a todos los clientes como uno solo.
# El compose prod fija esta subred y la pisa en la API; dejala igual.
TRUSTED_PROXIES=172.30.0.0/24

# --- Planes (límites y precios; 0 = sin límite) ------------------------------
PLAN_STARTER_MAX_BRANCHES=2
PLAN_STARTER_MAX_ACTIVE_SERVICES=3
PLAN_STARTER_PRICE=19800
PLAN_PRO_MAX_BRANCHES=4
PLAN_PRO_MAX_ACTIVE_SERVICES=0
PLAN_PRO_PRICE=29800
# Opcionales (defaults: métricas avanzadas y soporte prioritario solo en Pro).
# PLAN_STARTER_ADVANCED_METRICS=false
# PLAN_PRO_ADVANCED_METRICS=true
# PLAN_STARTER_PRIORITY_SUPPORT=false
# PLAN_PRO_PRIORITY_SUPPORT=true

# --- Mercado Pago (CAMBIAR: links reales de los planes de suscripción) -------
MP_STARTER_URL=https://www.mercadopago.com.ar/subscriptions/checkout?preapproval_plan_id=CAMBIAR
MP_PRO_URL=https://www.mercadopago.com.ar/subscriptions/checkout?preapproval_plan_id=CAMBIAR

# --- Storage S3 gestionado (CAMBIAR; R2, B2 o S3) ----------------------------
# Ejemplo R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  y región "auto".
S3_ENDPOINT=https://CAMBIAR
S3_REGION=auto
S3_BUCKET=movo
S3_ACCESS_KEY=CAMBIAR
S3_SECRET_KEY=CAMBIAR
# Según el proveedor (R2 y B2 suelen funcionar con path style; S3 con virtual host).
S3_PATH_STYLE=true
# El bucket se crea a mano en producción.
S3_ENSURE_BUCKET=false
# Origen público del sitio (CORS para subir imágenes con URL prefirmada).
S3_CORS_ORIGINS=https://CAMBIAR-tu-dominio.com
# S3_PRESIGN_TTL=
# CDN opcional delante del bucket (lecturas de imágenes); sin ella, URLs prefirmadas.
# IMAGES_CDN_URL=https://img.tu-dominio.com

# --- Geocodificación ---------------------------------------------------------
# Por defecto usa el Nominatim público (1 req/s, exige User-Agent con contacto real).
GEOCODER_USER_AGENT=MOVO/1.0 (contacto@tu-dominio.com)
# GEOCODER_URL=

# --- Caché de búsqueda (opcional) --------------------------------------------
# Sin REDIS_URL la API arranca igual, sin caché.
REDIS_URL=redis://redis:6379
# SEARCH_CACHE_TTL=
# SEARCH_CACHE_CELL_DEG=

# --- Límites (los defaults sirven; tocar solo con medición) ------------------
# SEARCH_RATE_LIMIT=
# COUPON_RATE_LIMIT_ATTEMPTS=
# MAX_BUSINESS_IMAGES=
# ALERT_MIN_CODES=
# ALERT_MIN_REDEEM_RATE=

# =============================================================================
# Frontend (Next). Las NEXT_PUBLIC_* se fijan en el BUILD, no al arrancar.
# =============================================================================

# URL interna de la API (red docker), no la pública.
API_URL=http://api:8080
# Número de soporte, solo dígitos con código de país (sin +).
NEXT_PUBLIC_SUPPORT_WHATSAPP=CAMBIAR
# Mapa: sin estas variables usa el estilo público de OpenFreeMap (piloto).
# Producción: PMTiles propio en el bucket (docs/work/fase-7-mapa.md).
# NEXT_PUBLIC_MAP_PMTILES_URL=https://CAMBIAR/planet.pmtiles
# NEXT_PUBLIC_MAP_ASSETS_URL=/map
# NEXT_PUBLIC_MAP_STYLE_URL=
# VPS de 1 GB: tope de memoria de Node (SDD 8.4).
NODE_OPTIONS=--max-old-space-size=200

# =============================================================================
# Caddy (deploy/caddy/Caddyfile)
# =============================================================================
# Dominio público: HTTPS automático. El escáner de QR exige HTTPS.
SITE_ADDRESS=CAMBIAR-tu-dominio.com
API_UPSTREAM=api:8080
WEB_UPSTREAM=web:3000

# =============================================================================
# docker-compose.prod.yml: imágenes (construidas fuera del VPS y subidas a un registro)
# =============================================================================
API_IMAGE=ghcr.io/CAMBIAR/movo-api:TAG
WORKER_IMAGE=ghcr.io/CAMBIAR/movo-worker:TAG
MIGRATE_IMAGE=ghcr.io/CAMBIAR/movo-migrate:TAG
WEB_IMAGE=ghcr.io/CAMBIAR/movo-web:TAG
